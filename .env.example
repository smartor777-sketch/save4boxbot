TELEGRAM_BOT_TOKEN=YOUR_TOKEN
SERVER_URL=http://127.0.0.1:8002
DOWNLOAD_DIR=./downloads
MAX_FILESIZE_MB=50
CLEANUP_INTERVAL_MIN=15
# Сколько минут хранить скачанные файлы, после чего они удаляются
FILE_MAX_AGE_MIN=15
# Максимум одновременных загрузок на сервер
MAX_CONCURRENT_DOWNLOADS=4
# Таймауты yt-dlp
YTDLP_SOCKET_TIMEOUT=30
DOWNLOAD_TIMEOUT_SEC=300
# Ретраи при ошибках извлечения
EXTRACT_RETRY_ATTEMPTS=3
EXTRACT_RETRY_BACKOFF_SEC=2
# Путь к cookie-файлу (Netscape) для YouTube/Instagram/TikTok, напр. ./cookies.txt
# ВАЖНО: cookies.txt добавлен в .gitignore, не коммитьте его в git.
COOKIE_FILE=
# Имитация браузера для yt-dlp (chrome/safari/...), пусто = отключено
IMPERSONATE=chrome
# Параллельная закачка фрагментов и размер чанка (обход троттлинга YouTube)
CONCURRENT_FRAGMENTS=4
HTTP_CHUNK_SIZE=10485760

